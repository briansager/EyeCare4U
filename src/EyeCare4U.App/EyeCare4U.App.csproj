<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\EyeCare4U.Core\EyeCare4U.Core.csproj" />
    <ProjectReference Include="..\EyeCare4U.Storage\EyeCare4U.Storage.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RuntimeFrameworkVersion>10.0.15</RuntimeFrameworkVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\EyeCare4U.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\EyeCare4U.ico" />
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
</Project>
